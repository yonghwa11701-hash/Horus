# Copy to supabase/functions/.env for local development only.
# Hosted: supabase secrets set --env-file supabase/functions/.env
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
ELEVENLABS_API_KEY=your-elevenlabs-key
# Person 3's functions only; never prefix either provider key with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-key
# Explicit browser allowlist. Native requests without Origin are accepted.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Enable only after Person 3 deploys process-segment with the shared request contract.
ENABLE_AGENT_DISPATCH=false
